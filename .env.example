# Create a .env.local file based on this example and fill in the values
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_LIST_IDS=1,2,3 # Comma-separated list of Brevo list IDs, e.g. "1,2,3"
QR_REDIRECT_BASE_URL=https://www.hkl.org/i-commit-2 # Base URL for HKL Form redirect
# Set to "true" to enable the interaction tracking form 
NEXT_PUBLIC_INTERACTIONS_FORM_ENABLED=false